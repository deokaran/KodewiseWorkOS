      unified_diff {
        lines {
          text: "# Changelog"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "All notable changes to this project will be documented in this file."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## [Unreleased] - Sprint 10 and beyond"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## [1.0.0] - Sprint 1-9 Completions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Added"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Authentication**: Implemented NextAuth integration with custom login page and role-based access control (Employee vs. Team Leader)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Database & Schema**: Configured Prisma with PostgreSQL/Neon, including core models for Users, Clients, Processes, Work Items, Stages, Notifications, and Tags."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Team Leader Dashboard**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Client Management**: Added Client details, contracts, quotas, and quota-based validations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Process Builder**: Created templates, versions, and stages. Implemented stage builder for workflow definition."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Work Management**: Added Work Items list, detail view with stage progression."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Open Work Pool**: Added capabilities to view, assign, and manage unclaimed pool items."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Settings**: Configured capabilities, event types, tags, work types, and team management."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Employee Dashboard**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **My Work**: View assigned work items and their stages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Open Pool**: Browse and claim available stages based on employee capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Process Library**: View published process definitions and standards."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Client Directory**: Browse active clients."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Profile**: View personal information and assigned capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Notifications**: Implemented notification bell, unread count badge, and notifications list view with mark-as-read functionality."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **UI Architecture**: Integrated shadcn/ui components, Next.js App Router layout, and global styling with Tailwind CSS."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Fixed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Stabilized Next.js App Router implementations and resolved basic layout constraints."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
