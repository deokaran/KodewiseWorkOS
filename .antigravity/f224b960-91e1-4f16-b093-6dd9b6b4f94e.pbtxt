cesses/[id]/page.tsx\n/app/(dashboard)/tl/processes/[id]/process-header.tsx\n/app/(dashboard)/tl/processes/[id]/versions/[versionId]/page.tsx\n/app/(dashboard)/tl/processes/[id]/versions/[versionId]/stage-builder.tsx\n/app/(dashboard)/tl/processes/[id]/versions/[versionId]/stage-form-dialog.tsx\n/app/(dashboard)/tl/processes/[id]/versions/[versionId]/version-header.tsx\n/app/(dashboard)/tl/processes/page.tsx\n/app/(dashboard)/tl/processes/process-form-dialog.tsx\n/app/(dashboard)/tl/processes/processes-client.tsx\n/app/(dashboard)/tl/settings/capabilities/capabilities-client.tsx\n/app/(dashboard)/tl/settings/capabilities/page.tsx\n/app/(dashboard)/tl/settings/event-types/event-types-client.tsx\n/app/(dashboard)/tl/settings/event-types/page.tsx\n/app/(dashboard)/tl/settings/layout.tsx\n/app/(dashboard)/tl/settings/page.tsx\n/app/(dashboard)/tl/settings/tags/page.tsx\n/app/(dashboard)/tl/settings/tags/tags-client.tsx\n/app/(dashboard)/tl/settings/team/page.tsx\n/app/(dashboard)/tl/settings/team/team-client.tsx\n/app/(dashboard)/tl/settings/work-types/page.tsx\n/app/(dashboard)/tl/settings/work-types/work-types-client.tsx\n/app/(dashboard)/tl/work/[id]/page.tsx\n/app/(dashboard)/tl/work/[id]/stage-action-buttons.tsx\n/app/(dashboard)/tl/work/[id]/stage-progress.tsx\n/app/(dashboard)/tl/work/[id]/work-header.tsx\n/app/(dashboard)/tl/work/page.tsx\n/app/(dashboard)/tl/work/work-client.tsx\n/app/(dashboard)/tl/work/work-form-dialog.tsx\n/app/api/auth/[...nextauth]/route.ts\n/app/globals.css\n/app/layout.tsx\n/app/not-found.tsx\n/app/page.tsx\n/assets/.aistudio/.gitignore\n/auth.config.ts\n/auth.ts\n/components.json\n/components/notifications/notification-bell.tsx\n/components/shared/empty-state.tsx\n/components/ui/badge.tsx\n/components/ui/button.tsx\n/components/ui/card.tsx\n/components/ui/dialog.tsx\n/components/ui/dropdown-menu.tsx\n/components/ui/input.tsx\n/components/ui/label.tsx\n/components/ui/progress.tsx\n/components/ui/select.tsx\n/components/ui/table.tsx\n/components/ui/tabs.tsx\n/components/ui/textarea.tsx\n/eslint.config.mjs\n/hooks/use-mobile.ts\n/lib/auth/utils.ts\n/lib/db/prisma.ts\n/lib/errors.ts\n/lib/utils.ts\n/lib/validations/capability.schema.ts\n/lib/validations/client.schema.ts\n/lib/validations/contract.schema.ts\n/lib/validations/event-type.schema.ts\n/lib/validations/open-pool.schema.ts\n/lib/validations/process-stage.schema.ts\n/lib/validations/process-version.schema.ts\n/lib/validations/process.schema.ts\n/lib/validations/tag.schema.ts\n/lib/validations/user.schema.ts\n/lib/validations/work-item.schema.ts\n/lib/validations/work-type.schema.ts\n/metadata.json\n/middleware.ts\n/next-env.d.ts\n/next.config.ts\n/package-lock.json\n/package.json\n/postcss.config.mjs\n/prisma/schema.prisma\n/prisma/seed.ts\n/services/CapabilityService.ts\n/services/ClientService.ts\n/services/ContractService.ts\n/services/EventTypeService.ts\n/services/NotificationService.ts\n/services/OpenPoolService.ts\n/services/ProcessRunService.ts\n/services/ProcessStageService.ts\n/services/ProcessTemplateService.ts\n/services/ProcessVersionService.ts\n/services/StageExecutionService.ts\n/services/StageProgressionService.ts\n/services/TagService.ts\n/services/UserService.ts\n/services/WorkItemService.ts\n/services/WorkNumberService.ts\n/services/WorkTypeService.ts\n/tsconfig.json\n/types/next-auth.d.ts\n\nThe following dependencies are installed:\n@base-ui/react: ^1.6.0\n@google/genai: ^2.4.0\n@hookform/resolvers: ^5.2.1\n@prisma/client: ^5.13.0\nautoprefixer: ^10.4.21\nbcryptjs: ^3.0.3\nclass-variance-authority: ^0.7.1\nclsx: ^2.1.1\ndate-fns: ^4.4.0\nlucide-react: ^0.553.0\nmotion: ^12.23.24\nnext: ^15.4.9\nnext-auth: ^5.0.0-beta.31\npostcss: ^8.5.6\nreact: ^19.2.1\nreact-dom: ^19.2.1\nreact-hook-form: ^7.80.0\nshadcn: ^4.12.0\ntailwind-merge: ^3.3.1\nzod: ^4.4.3\n\nThe following devDependencies are installed:\n@tailwindcss/postcss: 4.1.11\n@tailwindcss/typography: ^0.5.19\n@types/bcryptjs: ^2.4.6\n@types/node: ^20\n@types/react: ^19\n@types/react-dom: ^19\neslint: 9.39.1\neslint-config-next: 16.0.8\nfirebase-tools: ^15.0.0\nprisma: ^5.13.0\ntailwindcss: 4.1.11\ntsx: ^4.7.1\ntw-animate-css: ^1.4.0\ntypescript: 5.9.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# -----------------------------------------------------------------------------\n# Studio.Track - Environment Variables\n# -----------------------------------------------------------------------------\n\n# APP_URL: The canonical URL where this application is hosted.\n# Used for authentication callbacks and absolute links in emails.\nAPP_URL=\"http://localhost:3000\"\n\n# PRISMA / NEON POSTGRESQL\n# DATABASE_URL is used by the application for standard querying.\n# DIRECT_URL is required by Prisma for executing schema migrations on Neon.\nDATABASE_URL=\"postgres://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/studiotrack?sslmode=require\"\nDIRECT_URL=\"postgres://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/studiotrack?sslmode=require\"\n\n# AUTH.JS (NextAuth)\n# Generate a secret using: npx auth secret or openssl rand -base64 32\nAUTH_SECRET=\"your_generated_auth_secret_here\"\n\n```\n\n--- /app/(auth)/login/page.tsx ---\n```typescript\n\"use client\";\n\nimport { useActionState } from \"react\";\nimport { authenticate } from \"@/actions/auth\";\n\nexport default function LoginPage() {\n  const [errorMessage, formAction, isPending] = useActionState(\n    authenticate,\n    undefined,\n  );\n\n  return (\n    <div className=\"flex h-screen w-full items-center justify-center bg-gray-50\">\n      <div className=\"w-full max-w-md space-y-8 rounded-xl bg-white p-10 shadow-lg\">\n        <div className=\"text-center\">\n          <h2 className=\"mt-6 text-3xl font-bold tracking-tight text-gray-900\">\n            Studio.Track\n          </h2>\n          <p className=\"mt-2 text-sm text-gray-600\">\n            Sign in to your account\n          </p>\n        </div>\n        <form className=\"mt-8 space-y-6\" action={formAction}>\n          <div className=\"space-y-4 rounded-md shadow-sm\">\n            <div>\n              <label\n                htmlFor=\"email-address\"\n                className=\"mb-1 block text-sm font-medium text-gray-700\"\n              >\n                Email address\n              </label>\n              <input\n                id=\"email-address\"\n                name=\"email\"\n                type=\"email\"\n                autoComplete=\"email\"\n                required\n                className=\"relative block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6\"\n                placeholder=\"Email address\"\n              />\n            </div>\n            <div>\n              <label\n                htmlFor=\"password\"\n                className=\"mb-1 block text-sm font-medium text-gray-700\"\n              >\n                Password\n              </label>\n              <input\n                id=\"password\"\n                name=\"password\"\n                type=\"password\"\n                autoComplete=\"current-password\"\n                required\n                className=\"relative block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:z-10 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6\"\n                placeholder=\"Password\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <button\n              type=\"submit\"\n              aria-disabled={isPending}\n              disabled={isPending}\n              className=\"group relative flex w-full justify-center rounded-md bg-indigo-600 px-3 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50\"\n            >\n              {isPending ? \"Signing in...\" : \"Sign in\"}\n            </button>\n          </div>\n          {errorMessage && (\n            <div className=\"text-sm text-red-500 text-center font-medium\">\n              {errorMessage}\n            </div>\n          )}\n        </form>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/clients/[id]/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { ClientService } from \"@/services/ClientService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\n\nexport default async function EmployeeClientDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  await requireRole(\"EMPLOYEE\");\n  const client = await ClientService.getById(id);\n\n  if (!client || client.deletedAt) {\n    notFound();\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/employee/clients\" className=\"hover:text-indigo-600 hover:underline\">Clients</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{client.name}</span>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-xl border shadow-sm\">\n        <div>\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">{client.name}</h1>\n          </div>\n          \n          <div className=\"mt-3 flex flex-wrap gap-2\">\n            {client.tags.length > 0 ? (\n              client.tags.map(t => (\n                <Badge key={t.tag.id} variant=\"outline\" style={{ borderColor: t.tag.color || undefined }}>\n                  {t.tag.name}\n                </Badge>\n              ))\n            ) : (\n              <span className=\"text-sm text-gray-400\">No tags assigned</span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <Card>\n          <CardHeader>\n            <CardTitle>General Information</CardTitle>\n          </CardHeader>\n          <CardContent className=\"space-y-4\">\n            {client.description && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Description</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{client.description}</p>\n              </div>\n            )}\n            {client.contactPerson && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Contact Person</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{client.contactPerson}</p>\n              </div>\n            )}\n            {client.email && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Email</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">\n                  <a href={`mailto:${client.email}`} className=\"text-indigo-600 hover:underline\">{client.email}</a>\n                </p>\n              </div>\n            )}\n            {client.phone && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Phone</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{client.phone}</p>\n              </div>\n            )}\n            {client.website && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Website</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">\n                  <a href={client.website} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-indigo-600 hover:underline\">\n                    {client.website}\n                  </a>\n                </p>\n              </div>\n            )}\n            {client.address && (\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Address</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{client.address}</p>\n              </div>\n            )}\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardHeader>\n            <CardTitle>Internal Notes</CardTitle>\n          </CardHeader>\n          <CardContent>\n            {client.notes ? (\n              <p className=\"text-sm text-gray-900 whitespace-pre-wrap\">{client.notes}</p>\n            ) : (\n              <p className=\"text-sm text-gray-500\">No notes available.</p>\n            )}\n          </CardContent>\n        </Card>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/clients/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport { ClientService } from \"@/services/ClientService\";\nimport { TagService } from \"@/services/TagService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport Link from \"next/link\";\n\nexport default async function EmployeeClientsPage() {\n  await requireRole(\"EMPLOYEE\");\n  const clients = await ClientService.list();\n\n  const activeClients = clients.filter(c => !c.deletedAt);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Clients</h2>\n        <p className=\"text-sm text-gray-500\">\n          View active client portfolio.\n        </p>\n      </div>\n\n      <div className=\"rounded-md border bg-white\">\n        <Table>\n          <TableHeader>\n            <TableRow>\n              <TableHead>Client</TableHead>\n              <TableHead>Contact</TableHead>\n              <TableHead>Tags</TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {activeClients.map(client => (\n              <TableRow key={client.id} className=\"hover:bg-gray-50\">\n                <TableCell className=\"font-medium\">\n                  <div className=\"flex flex-col\">\n                    <Link href={`/employee/clients/${client.id}`} className=\"text-indigo-600 hover:underline\">\n                      <span>{client.name}</span>\n                    </Link>\n                    {client.website && <span className=\"text-xs text-gray-500 font-normal\">{client.website}</span>}\n                  </div>\n                </TableCell>\n                <TableCell>\n                    <div className=\"flex flex-col text-sm text-gray-600\">\n                      <span>{client.contactPerson || \'-\'}</span>\n                      <span className=\"text-xs text-gray-400\">{client.email || \'\'}</span>\n                    </div>\n                  </TableCell>\n                  <TableCell>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {client.tags.slice(0, 3).map(t => (\n                        <Badge key={t.tag.id} variant=\"outline\" style={{ borderColor: t.tag.color || undefined }}>\n                          {t.tag.name}\n                        </Badge>\n                      ))}\n                      {client.tags.length > 3 && (\n                        <Badge variant=\"outline\">+{client.tags.length - 3}</Badge>\n                      )}\n                    </div>\n                  </TableCell>\n              </TableRow>\n            ))}\n            {activeClients.length === 0 && (\n              <TableRow>\n                <TableCell colSpan={3} className=\"h-32 text-center text-gray-500\">\n                  No active clients found.\n                </TableCell>\n              </TableRow>\n            )}\n          </TableBody>\n        </Table>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\n\nexport default async function EmployeePage() {\n  const user = await requireRole(\"EMPLOYEE\");\n\n  return (\n    <div className=\"space-y-6\">\n      <h2 className=\"text-2xl font-bold text-gray-900\">Employee Dashboard</h2>\n      <div className=\"rounded-xl bg-white p-6 shadow-sm border\">\n        <p className=\"text-gray-600\">\n          Welcome, {user.name}. Here is your assigned work queue.\n        </p>\n        <div className=\"mt-4\">\n          <h3 className=\"text-sm font-semibold text-gray-900\">Your Capabilities:</h3>\n          <ul className=\"mt-2 list-disc pl-5 text-sm text-gray-600\">\n            {user.capabilities?.map((cap) => (\n              <li key={cap}>{cap}</li>\n            ))}\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/pool/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport { OpenPoolService } from \"@/services/OpenPoolService\";\nimport { PoolStageCard } from \"./pool-stage-card\";\n\nexport default async function EmployeePoolPage() {\n  const user = await requireRole(\"EMPLOYEE\");\n  const poolItems = await OpenPoolService.getPoolItemsForEmployee(user.id);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">Open Work Pool</h1>\n          <p className=\"text-sm text-gray-500 mt-1\">Available stages matching your capabilities.</p>\n        </div>\n      </div>\n\n      {poolItems.length === 0 ? (\n        <div className=\"text-center py-12 bg-white rounded-lg border border-gray-200\">\n          <p className=\"text-gray-500 text-sm\">No pool items available matching your capabilities at the moment.</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {poolItems.map(item => (\n            <PoolStageCard key={item.id} item={item} />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/processes/[id]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { ProcessTemplateService } from \"@/services/ProcessTemplateService\";\nimport { ProcessVersionService } from \"@/services/ProcessVersionService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { formatDistanceToNow } from \"date-fns\";\n\nexport default async function EmployeeProcessDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  const process = await ProcessTemplateService.getById(id);\n\n  if (!process) {\n    notFound();\n  }\n\n  const publishedVersionSummary = process.versions.find(v => v.isPublished);\n  if (!publishedVersionSummary) {\n    notFound(); // Employees can only see published processes\n  }\n\n  const publishedVersion = await ProcessVersionService.getById(publishedVersionSummary.id) as any;\n\n  if (!publishedVersion) {\n    notFound();\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/employee/processes\" className=\"hover:text-indigo-600 hover:underline\">Processes</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{process.name}</span>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-xl border shadow-sm\">\n        <div>\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">{process.name}</h1>\n            <Badge variant=\"default\" className=\"bg-green-100 text-green-800\">Active Version: v{publishedVersion.version}</Badge>\n          </div>\n          {process.description && (\n            <p className=\"text-sm text-gray-500 mt-2\">{process.description}</p>\n          )}\n        </div>\n      </div>\n\n      <div className=\"space-y-6\">\n        <h3 className=\"text-lg font-semibold text-gray-900\">Process Stages</h3>\n        \n        {publishedVersion.stages.length === 0 ? (\n          <div className=\"text-center p-8 border border-dashed rounded-lg bg-gray-50 text-gray-500\">\n            No stages are defined for this process.\n          </div>\n        ) : (\n          <div className=\"space-y-4 max-w-4xl\">\n            {publishedVersion.stages.map((stage: any, index: number) => (\n              <div key={stage.id} className=\"flex gap-4 items-stretch bg-white border rounded-lg shadow-sm p-4\">\n                <div className=\"flex flex-col items-center justify-center gap-1 border-r pr-4 min-w-[3rem]\">\n                  <div className=\"text-sm font-medium text-gray-400\">#{index + 1}</div>\n                </div>\n\n                <div className=\"flex-1 py-1\">\n                  <div className=\"flex justify-between items-start\">\n                    <div>\n                      <h4 className=\"font-semibold text-gray-900\">{stage.name}</h4>\n                      <div className=\"flex gap-2 text-sm text-gray-500 mt-1\">\n                        <span>{stage.estimatedDurationMins} mins</span>\n                        {stage.capability && (\n                          <>\n                            <span>\342\200\242</span>\n                            <span>{stage.capability.name}</span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n\n                  {stage.instructions && (\n                    <div className=\"mt-3 p-3 bg-gray-50 rounded-md text-sm text-gray-700 whitespace-pre-wrap\">\n                      {stage.instructions}\n                    </div>\n                  )}\n\n                  <div className=\"flex flex-wrap gap-2 mt-3\">\n                    {stage.requiresTLApproval && (\n                      <span className=\"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800\">\n                        TL Approval Required\n                      </span>\n                    )}\n                    {stage.requiresManualClientAcceptance && (\n                      <span className=\"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800\">\n                        Client Acceptance Required\n                      </span>\n                    )}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/processes/page.tsx ---\n```typescript\nimport { ProcessTemplateService } from \"@/services/ProcessTemplateService\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport { Badge } from \"@/components/ui/badge\";\nimport Link from \"next/link\";\nimport { ProcessTemplate, ProcessTemplateVersion } from \"@prisma/client\";\n\nexport default async function EmployeeProcessesPage() {\n  const allProcesses = await ProcessTemplateService.list();\n  \n  // Filter for published ones only\n  const publishedProcesses = allProcesses.filter(p => p.versions.some(v => v.isPublished));\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Process Library</h2>\n        <p className=\"text-sm text-gray-500\">\n          View standardized workflow processes for the studio.\n        </p>\n      </div>\n\n      <div className=\"rounded-md border bg-white\">\n        <Table>\n          <TableHeader>\n            <TableRow>\n              <TableHead>Process Name</TableHead>\n              <TableHead>Description</TableHead>\n              <TableHead>Current Version</TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {publishedProcesses.map(process => {\n              const publishedVersion = process.versions.find(v => v.isPublished);\n              return (\n                <TableRow key={process.id} className=\"hover:bg-gray-50\">\n                  <TableCell className=\"font-medium\">\n                    <Link href={`/employee/processes/${process.id}`} className=\"text-indigo-600 hover:underline\">\n                      {process.name}\n                    </Link>\n                  </TableCell>\n                  <TableCell>\n                    <div className=\"text-sm text-gray-500 line-clamp-1 max-w-xs\">\n                      {process.description || \'-\'}\n                    </div>\n                  </TableCell>\n                  <TableCell>\n                    <Badge variant=\"secondary\">v{publishedVersion?.version}</Badge>\n                  </TableCell>\n                </TableRow>\n              );\n            })}\n            {publishedProcesses.length === 0 && (\n              <TableRow>\n                <TableCell colSpan={3} className=\"h-32 text-center text-gray-500\">\n                  No published processes available yet.\n                </TableCell>\n              </TableRow>\n            )}\n          </TableBody>\n        </Table>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/profile/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport { UserService } from \"@/services/UserService\";\nimport { Badge } from \"@/components/ui/badge\";\n\nexport default async function EmployeeProfilePage() {\n  const user = await requireRole(\"EMPLOYEE\");\n  const fullUser = await UserService.getById(user.id);\n\n  if (!fullUser) {\n    return <div>User not found</div>;\n  }\n\n  return (\n    <div className=\"space-y-6 max-w-2xl\">\n      <div>\n        <h2 className=\"text-2xl font-bold text-gray-900\">My Profile</h2>\n        <p className=\"text-sm text-gray-500\">View your personal information and assigned capabilities.</p>\n      </div>\n\n      <div className=\"rounded-xl border bg-white p-6 shadow-sm space-y-6\">\n        <div>\n          <h3 className=\"text-sm font-medium text-gray-500\">Name</h3>\n          <p className=\"mt-1 text-lg font-medium text-gray-900\">{fullUser.name}</p>\n        </div>\n        \n        <div>\n          <h3 className=\"text-sm font-medium text-gray-500\">Email</h3>\n          <p className=\"mt-1 text-lg text-gray-900\">{fullUser.email}</p>\n        </div>\n\n        <div>\n          <h3 className=\"text-sm font-medium text-gray-500\">Role</h3>\n          <Badge className=\"mt-1\" variant=\"secondary\">{fullUser.role}</Badge>\n        </div>\n\n        <div>\n          <h3 className=\"text-sm font-medium text-gray-500\">My Capabilities</h3>\n          <div className=\"mt-2 flex flex-wrap gap-2\">\n            {fullUser.capabilities.length > 0 ? (\n              fullUser.capabilities.map(cap => (\n                <Badge key={cap.id} variant=\"outline\">{cap.name}</Badge>\n              ))\n            ) : (\n              <p className=\"text-sm text-gray-400\">No capabilities assigned.</p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/work/[id]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { WorkItemService } from \"@/services/WorkItemService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { StageActionButtons } from \"../../../tl/work/[id]/stage-action-buttons\";\nimport { StageProgress } from \"../../../tl/work/[id]/stage-progress\";\nimport { getSessionUser } from \"@/lib/auth/utils\";\n\nexport default async function EmployeeWorkItemDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  const workItem = await WorkItemService.getById(id);\n  const user = await getSessionUser();\n\n  if (!workItem || workItem.deletedAt || !user) {\n    notFound();\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/employee/work\" className=\"hover:text-indigo-600 hover:underline\">Work Items</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{workItem.workNumber}</span>\n      </div>\n\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-xl border shadow-sm\">\n        <div>\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">{workItem.workNumber}</h1>\n            <span className=\"text-lg text-gray-500\">{workItem.title}</span>\n            <Badge variant=\"outline\">{workItem.primaryBrandTag.name}</Badge>\n            <Badge variant=\"default\" className=\"bg-green-100 text-green-800 hover:bg-green-100\">{workItem.status}</Badge>\n            <Badge variant={workItem.priority === \'CRITICAL\' ? \'destructive\' : \'secondary\'}>{workItem.priority}</Badge>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Stages</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {workItem.stages.map((stage: any, index: number) => {\n                  const isActive = stage.id === workItem.currentStageId;\n                  return (\n                    <div key={stage.id} className={`flex gap-4 p-4 border rounded-lg ${isActive ? \'bg-indigo-50 border-indigo-200\' : \'bg-white\'}`}>\n                      <div className=\"flex flex-col items-center justify-center border-r pr-4 min-w-[3rem]\">\n                        <div className={`text-sm font-medium ${isActive ? \'text-indigo-600\' : \'text-gray-400\'}`}>\n                          #{index + 1}\n                        </div>\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex justify-between items-start\">\n                          <div>\n                            <h4 className={`font-semibold ${isActive ? \'text-indigo-900\' : \'text-gray-900\'}`}>\n                              {stage.stageTemplate.name}\n                            </h4>\n                            <div className=\"text-sm text-gray-500 mt-1 flex gap-2\">\n                              <span>{stage.stageTemplate.estimatedDurationMins} mins</span>\n                              {stage.capability && (\n                                <>\n                                  <span>\342\200\242</span>\n                                  <span>{stage.capability.name}</span>\n                                </>\n                              )}\n                            </div>\n                          </div>\n                          <Badge variant={isActive ? \"default\" : (stage.status === \'COMPLETED\' ? \"secondary\" : \"outline\")}>\n                            {stage.status}\n                          </Badge>\n                        </div>\n                        {isActive && (\n                          <StageActionButtons stage={stage} workItemId={workItem.id} userRole={user.role} />\n                        )}\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <div className=\"space-y-6\">\n          <StageProgress workItem={workItem} />\n          \n          <Card>\n            <CardHeader>\n              <CardTitle>Details</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Description</h4>\n                <p className=\"mt-1 text-sm text-gray-900 whitespace-pre-wrap\">{workItem.description || \'No description provided.\'}</p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Client</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{workItem.client?.name || \'None\'}</p>\n              </div>\n\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Work Type</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{workItem.workType?.name || \'None\'}</p>\n              </div>\n\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Process</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">\n                  {workItem.processVersion.template.name} (v{workItem.processVersion.version})\n                </p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Tags</h4>\n                <div className=\"flex flex-wrap gap-2 mt-1\">\n                  {workItem.tags.map((t: any) => (\n                    <Badge key={t.tagId} variant=\"outline\" style={{ borderColor: t.tag.color || undefined }}>\n                      {t.tag.name}\n                    </Badge>\n                  ))}\n                  {workItem.tags.length === 0 && <span className=\"text-sm text-gray-500\">None</span>}\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/employee/work/page.tsx ---\n```typescript\nimport { WorkItemService } from \"@/services/WorkItemService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport Link from \"next/link\";\n\nexport default async function EmployeeWorkItemsPage() {\n  const workItems = await WorkItemService.list();\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Work Items</h2>\n        <p className=\"text-sm text-gray-500\">\n          View all active work across the studio.\n        </p>\n      </div>\n\n      <div className=\"rounded-md border bg-white\">\n        <Table>\n          <TableHeader>\n            <TableRow>\n              <TableHead>ID</TableHead>\n              <TableHead>Title</TableHead>\n              <TableHead>Brand</TableHead>\n              <TableHead>Priority</TableHead>\n              <TableHead>Status</TableHead>\n              <TableHead>Process</TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {workItems.filter((w: any) => !w.deletedAt).map((item: any) => (\n              <TableRow key={item.id} className=\"hover:bg-gray-50\">\n                <TableCell className=\"font-medium text-indigo-600\">\n                  <Link href={`/employee/work/${item.id}`} className=\"hover:underline\">\n                    {item.workNumber}\n                  </Link>\n                </TableCell>\n                <TableCell>\n                  <div className=\"font-medium text-gray-900\">{item.title}</div>\n                  <div className=\"text-xs text-gray-500\">{item.client?.name}</div>\n                </TableCell>\n                <TableCell>\n                  <Badge variant=\"outline\">{item.primaryBrandTag.name}</Badge>\n                </TableCell>\n                <TableCell>\n                  <Badge variant={item.priority === \"CRITICAL\" ? \"destructive\" : \"secondary\"}>\n                    {item.priority}\n                  </Badge>\n                </TableCell>\n                <TableCell>\n                  <Badge variant=\"outline\">{item.status}</Badge>\n                </TableCell>\n                <TableCell className=\"text-sm text-gray-500\">\n                  {item.processVersion.template.name} v{item.processVersion.version}\n                </TableCell>\n              </TableRow>\n            ))}\n            {workItems.length === 0 && (\n              <TableRow>\n                <TableCell colSpan={6} className=\"h-32 text-center text-gray-500\">\n                  No active work items found.\n                </TableCell>\n              </TableRow>\n            )}\n          </TableBody>\n        </Table>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/layout.tsx ---\n```typescript\nimport { ReactNode } from \"react\";\nimport { getSessionUser } from \"@/lib/auth/utils\";\nimport { redirect } from \"next/navigation\";\nimport { logOut } from \"@/actions/auth\";\nimport Link from \"next/link\";\nimport { NotificationBell } from \"@/components/notifications/notification-bell\";\nimport { NotificationService } from \"@/services/NotificationService\";\n\nexport default async function DashboardLayout({ children }: { children: ReactNode }) {\n  const user = await getSessionUser();\n\n  if (!user) {\n    redirect(\"/login\");\n  }\n  \n  const unreadCount = await NotificationService.getUnreadCount(user.id);\n\n  return (\n    <div className=\"flex min-h-screen flex-col bg-gray-50\">\n      <header className=\"flex h-16 items-center justify-between border-b bg-white px-6 shadow-sm\">\n        <div className=\"flex items-center gap-4\">\n          <h1 className=\"text-xl font-bold tracking-tight text-gray-900\">Studio.Track</h1>\n          <span className=\"rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800\">\n            {user.role}\n          </span>\n        </div>\n        <div className=\"flex items-center gap-6\">\n          <NotificationBell initialCount={unreadCount} />\n          \n          <div className=\"text-sm font-medium text-gray-700\">\n            {user.name} ({user.email})\n          </div>\n          <form action={logOut}>\n            <button\n              type=\"submit\"\n              className=\"rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-200\"\n            >\n              Sign out\n            </button>\n          </form>\n        </div>\n      </header>\n\n      <div className=\"flex flex-1\">\n        <aside className=\"w-64 border-r bg-white p-6 shadow-sm\">\n          <nav className=\"space-y-4\">\n            {user.role === \"TEAM_LEADER\" ? (\n              <>\n                <Link href=\"/tl\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Dashboard</Link>\n                <Link href=\"/tl/work\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Work Items</Link>\n                <Link href=\"/tl/pool\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Open Work Pool</Link>\n                <Link href=\"/tl/processes\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Process Builder</Link>\n                <Link href=\"/tl/clients\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Clients & Quotas</Link>\n                <Link href=\"/tl/settings\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Settings</Link>\n              </>\n            ) : (\n              <>\n                <Link href=\"/employee\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">My Dashboard</Link>\n                <Link href=\"/employee/work\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Work</Link>\n                <Link href=\"/employee/processes\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Process Library</Link>\n                <Link href=\"/employee/clients\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Clients</Link>\n                <Link href=\"/employee/profile\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">My Profile</Link>\n                <Link href=\"/employee/pool\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Open Work Pool</Link>\n              </>\n            )}\n            <Link href=\"/history\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Global History</Link>\n            <Link href=\"/calendar\" className=\"block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600\">Calendar</Link>\n          </nav>\n        </aside>\n\n        <main className=\"flex-1 p-8\">\n          {children}\n        </main>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/notifications/page.tsx ---\n```typescript\nimport { requireAuth } from \"@/lib/auth/utils\";\nimport { NotificationService } from \"@/services/NotificationService\";\nimport { NotificationList } from \"./notification-list\";\nimport { MarkAllReadButton } from \"./mark-all-read-button\";\n\nexport default async function NotificationsPage({ searchParams }: { searchParams: Promise<{ unread?: string }> }) {\n  const user = await requireAuth();\n  const params = await searchParams;\n  const filterUnread = params.unread === \"true\";\n  \n  const notifications = await NotificationService.getUserNotifications(user.id, filterUnread);\n\n  return (\n    <div className=\"max-w-3xl mx-auto space-y-6\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">Notifications</h1>\n          <p className=\"text-sm text-gray-500 mt-1\">Stay updated on your work items and tasks.</p>\n        </div>\n        <MarkAllReadButton />\n      </div>\n\n      <div className=\"bg-white rounded-xl border shadow-sm overflow-hidden\">\n        <NotificationList notifications={notifications} filterUnread={filterUnread} />\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/clients/[id]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { ClientService } from \"@/services/ClientService\";\nimport { TagService } from \"@/services/TagService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { ClientHeader } from \"./client-header\";\nimport { ContractList } from \"./contract-list\";\n\nexport default async function ClientDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  const [client, tags] = await Promise.all([\n    ClientService.getById(id),\n    TagService.list()\n  ]);\n\n  if (!client) {\n    notFound();\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/tl/clients\" className=\"hover:text-indigo-600 hover:underline\">Clients</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{client.name}</span>\n      </div>\n\n      <ClientHeader client={client} allTags={tags} />\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"md:col-span-2 space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Contracts</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ContractList clientId={client.id} contracts={client.contracts} />\n            </CardContent>\n          </Card>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n            <Card className=\"opacity-60 bg-gray-50 border-dashed\">\n              <CardHeader>\n                <CardTitle className=\"text-gray-500\">Recent Activity</CardTitle>\n              </CardHeader>\n              <CardContent className=\"text-sm text-gray-500\">\n                Activity log will be implemented in a future sprint.\n              </CardContent>\n            </Card>\n\n            <Card className=\"opacity-60 bg-gray-50 border-dashed\">\n              <CardHeader>\n                <CardTitle className=\"text-gray-500\">Future Work Summary</CardTitle>\n              </CardHeader>\n              <CardContent className=\"text-sm text-gray-500\">\n                Deliverables forecasting will be implemented in a future sprint.\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n\n        <div className=\"space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle>General Information</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              {client.description && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Description</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">{client.description}</p>\n                </div>\n              )}\n              {client.contactPerson && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Contact Person</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">{client.contactPerson}</p>\n                </div>\n              )}\n              {client.email && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Email</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">\n                    <a href={`mailto:${client.email}`} className=\"text-indigo-600 hover:underline\">{client.email}</a>\n                  </p>\n                </div>\n              )}\n              {client.phone && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Phone</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">{client.phone}</p>\n                </div>\n              )}\n              {client.website && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Website</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">\n                    <a href={client.website} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-indigo-600 hover:underline\">\n                      {client.website}\n                    </a>\n                  </p>\n                </div>\n              )}\n              {client.address && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Address</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">{client.address}</p>\n                </div>\n              )}\n              {client.notes && (\n                <div className=\"pt-4 border-t\">\n                  <h4 className=\"text-sm font-medium text-gray-500\">Internal Notes</h4>\n                  <p className=\"mt-1 text-sm text-gray-900 whitespace-pre-wrap\">{client.notes}</p>\n                </div>\n              )}\n            </CardContent>\n          </Card>\n\n          <Card className=\"opacity-60 bg-gray-50 border-dashed\">\n            <CardHeader>\n              <CardTitle className=\"text-gray-500\">Statistics</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-sm text-gray-500\">Total Work Items</span>\n                <span className=\"text-sm font-medium text-gray-900\">{client._count.workItems}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-sm text-gray-500\">Active Contracts</span>\n                <span className=\"text-sm font-medium text-gray-900\">{client.contracts.filter(c => c.isActive).length}</span>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/clients/page.tsx ---\n```typescript\nimport { ClientService } from \"@/services/ClientService\";\nimport { TagService } from \"@/services/TagService\";\nimport { ClientsClient } from \"./clients-client\";\n\nexport default async function ClientsPage() {\n  const [clients, tags] = await Promise.all([\n    ClientService.list(),\n    TagService.list()\n  ]);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Clients</h2>\n        <p className=\"text-sm text-gray-500\">\n          Manage your client portfolio, view contracts, and track deliverables.\n        </p>\n      </div>\n\n      <ClientsClient initialClients={clients} tags={tags} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\n\nexport default async function TLPage() {\n  const user = await requireRole(\"TEAM_LEADER\");\n\n  return (\n    <div className=\"space-y-6\">\n      <h2 className=\"text-2xl font-bold text-gray-900\">Team Leader Dashboard</h2>\n      <div className=\"rounded-xl bg-white p-6 shadow-sm border\">\n        <p className=\"text-gray-600\">\n          Welcome, {user.name}. You have full access to internal modules.\n        </p>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/pool/page.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport { OpenPoolService } from \"@/services/OpenPoolService\";\nimport { UserService } from \"@/services/UserService\";\nimport { TLPoolTable } from \"./tl-pool-table\";\n\nexport default async function TLPoolPage() {\n  await requireRole(\"TEAM_LEADER\");\n  const poolItems = await OpenPoolService.getAllPoolItems();\n  const employees = await UserService.listByRole(\"EMPLOYEE\");\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-gray-900\">Open Work Pool</h1>\n          <p className=\"text-sm text-gray-500 mt-1\">Manage and assign open pool stages to employees.</p>\n        </div>\n      </div>\n\n      <div className=\"bg-white rounded-xl border shadow-sm overflow-hidden\">\n        <TLPoolTable poolItems={poolItems} employees={employees} />\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/processes/[id]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { ProcessTemplateService } from \"@/services/ProcessTemplateService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { ProcessHeader } from \"./process-header\";\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from \"@/components/ui/table\";\nimport { formatDistanceToNow } from \"date-fns\";\n\nexport default async function ProcessDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  const process = await ProcessTemplateService.getById(id);\n\n  if (!process) {\n    notFound();\n  }\n\n  const publishedVersion = process.versions.find(v => v.isPublished);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/tl/processes\" className=\"hover:text-indigo-600 hover:underline\">Processes</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{process.name}</span>\n      </div>\n\n      <ProcessHeader process={process} />\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div className=\"md:col-span-2 space-y-6\">\n          <Card>\n            <CardHeader className=\"flex flex-row items-center justify-between\">\n              <CardTitle>Versions</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <Table>\n                <TableHeader>\n                  <TableRow>\n                    <TableHead>Version</TableHead>\n                    <TableHead>Status</TableHead>\n                    <TableHead>Stages</TableHead>\n                    <TableHead>Created</TableHead>\n                    <TableHead className=\"text-right\">Action</TableHead>\n                  </TableRow>\n                </TableHeader>\n                <TableBody>\n                  {process.versions.map(version => (\n                    <TableRow key={version.id}>\n                      <TableCell className=\"font-medium\">\n                        v{version.version}\n                      </TableCell>\n                      <TableCell>\n                        {version.isPublished ? (\n                          <Badge className=\"bg-green-100 text-green-800 hover:bg-green-100\">Published</Badge>\n                        ) : (\n                          <Badge variant=\"secondary\">Draft</Badge>\n                        )}\n                      </TableCell>\n                      <TableCell>{version._count.stages} stages</TableCell>\n                      <TableCell className=\"text-gray-500 text-sm\">\n                        {formatDistanceToNow(new Date(version.createdAt), { addSuffix: true })}\n                      </TableCell>\n                      <TableCell className=\"text-right\">\n                        <Link href={`/tl/processes/${process.id}/versions/${version.id}`}>\n                          <Button variant=\"ghost\" size=\"sm\">Open Builder</Button>\n                        </Link>\n                      </TableCell>\n                    </TableRow>\n                  ))}\n                  {process.versions.length === 0 && (\n                    <TableRow>\n                      <TableCell colSpan={5} className=\"text-center text-gray-500 py-6\">\n                        No versions found.\n                      </TableCell>\n                    </TableRow>\n                  )}\n                </TableBody>\n              </Table>\n            </CardContent>\n          </Card>\n        </div>\n\n        <div className=\"space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Process Information</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Name</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{process.name}</p>\n              </div>\n              {process.description && (\n                <div>\n                  <h4 className=\"text-sm font-medium text-gray-500\">Description</h4>\n                  <p className=\"mt-1 text-sm text-gray-900\">{process.description}</p>\n                </div>\n              )}\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Current Published</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">\n                  {publishedVersion ? `v${publishedVersion.version}` : \'None\'}\n                </p>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/processes/[id]/versions/[versionId]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { ProcessVersionService } from \"@/services/ProcessVersionService\";\nimport { CapabilityService } from \"@/services/CapabilityService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { StageBuilder } from \"./stage-builder\";\nimport { VersionHeader } from \"./version-header\";\n\nexport default async function ProcessVersionPage({ params }: { params: Promise<{ id: string, versionId: string }> }) {\n  const { id, versionId } = await params;\n  const [version, capabilities] = await Promise.all([\n    ProcessVersionService.getById(versionId) as Promise<any>,\n    CapabilityService.list()\n  ]);\n\n  if (!version || version.templateId !== id) {\n    notFound();\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/tl/processes\" className=\"hover:text-indigo-600 hover:underline\">Processes</Link>\n        <span>/</span>\n        <Link href={`/tl/processes/${version.templateId}`} className=\"hover:text-indigo-600 hover:underline\">{version.template.name}</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">v{version.version}</span>\n      </div>\n\n      <VersionHeader version={version} template={version.template} />\n\n      <div className=\"mt-8\">\n        <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">Stages</h3>\n        <StageBuilder \n          processId={id} \n          versionId={versionId} \n          stages={version.stages} \n          capabilities={capabilities}\n          isReadOnly={version.isPublished}\n        />\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/processes/page.tsx ---\n```typescript\nimport { ProcessTemplateService } from \"@/services/ProcessTemplateService\";\nimport { ProcessesClient } from \"./processes-client\";\n\nexport default async function ProcessesPage() {\n  const processes = await ProcessTemplateService.list();\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Process Builder</h2>\n        <p className=\"text-sm text-gray-500\">\n          Design and manage workflow templates.\n        </p>\n      </div>\n\n      <ProcessesClient initialProcesses={processes} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/capabilities/page.tsx ---\n```typescript\nimport { CapabilityService } from \"@/services/CapabilityService\";\nimport { CapabilitiesClient } from \"./capabilities-client\";\n\nexport default async function CapabilitiesPage() {\n  const capabilities = await CapabilityService.list();\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h3 className=\"text-lg font-medium text-gray-900\">Capabilities</h3>\n          <p className=\"text-sm text-gray-500\">Manage internal team capabilities (roles/skills).</p>\n        </div>\n      </div>\n\n      <CapabilitiesClient capabilities={capabilities} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/event-types/page.tsx ---\n```typescript\nimport { EventTypeService } from \"@/services/EventTypeService\";\nimport { EventTypesClient } from \"./event-types-client\";\n\nexport default async function EventTypesPage() {\n  const eventTypes = await EventTypeService.list();\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h3 className=\"text-lg font-medium text-gray-900\">Event Types</h3>\n          <p className=\"text-sm text-gray-500\">Manage calendar event categories.</p>\n        </div>\n      </div>\n\n      <EventTypesClient eventTypes={eventTypes} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/layout.tsx ---\n```typescript\nimport { requireRole } from \"@/lib/auth/utils\";\nimport Link from \"next/link\";\nimport { ReactNode } from \"react\";\n\nexport default async function SettingsLayout({ children }: { children: ReactNode }) {\n  await requireRole(\"TEAM_LEADER\");\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Settings</h2>\n        <p className=\"text-sm text-gray-500\">\n          Manage your team, tags, capabilities, and system configuration.\n        </p>\n      </div>\n\n      <div className=\"flex gap-4 border-b border-gray-200\">\n        <Link href=\"/tl/settings/team\" className=\"border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 data-[active=true]:border-indigo-600 data-[active=true]:text-indigo-600\">\n          Team\n        </Link>\n        <Link href=\"/tl/settings/capabilities\" className=\"border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 data-[active=true]:border-indigo-600 data-[active=true]:text-indigo-600\">\n          Capabilities\n        </Link>\n        <Link href=\"/tl/settings/tags\" className=\"border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 data-[active=true]:border-indigo-600 data-[active=true]:text-indigo-600\">\n          Tags\n        </Link>\n        <Link href=\"/tl/settings/work-types\" className=\"border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 data-[active=true]:border-indigo-600 data-[active=true]:text-indigo-600\">\n          Work Types\n        </Link>\n        <Link href=\"/tl/settings/event-types\" className=\"border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 data-[active=true]:border-indigo-600 data-[active=true]:text-indigo-600\">\n          Event Types\n        </Link>\n      </div>\n\n      <div className=\"pt-4\">\n        {children}\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/page.tsx ---\n```typescript\nimport { redirect } from \"next/navigation\";\n\nexport default function SettingsPage() {\n  redirect(\"/tl/settings/team\");\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/tags/page.tsx ---\n```typescript\nimport { TagService } from \"@/services/TagService\";\nimport { TagsClient } from \"./tags-client\";\n\nexport default async function TagsPage() {\n  const tags = await TagService.list();\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h3 className=\"text-lg font-medium text-gray-900\">Tags</h3>\n          <p className=\"text-sm text-gray-500\">Manage tags for brands, clients, and statuses.</p>\n        </div>\n      </div>\n\n      <TagsClient tags={tags} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/team/page.tsx ---\n```typescript\nimport { UserService } from \"@/services/UserService\";\nimport { CapabilityService } from \"@/services/CapabilityService\";\nimport { TeamClient } from \"./team-client\";\n\nexport default async function TeamPage() {\n  const [users, capabilities] = await Promise.all([\n    UserService.list(),\n    CapabilityService.list(),\n  ]);\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h3 className=\"text-lg font-medium text-gray-900\">Team Management</h3>\n          <p className=\"text-sm text-gray-500\">Manage your internal team members and their roles.</p>\n        </div>\n      </div>\n\n      <TeamClient users={users} capabilities={capabilities} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/settings/work-types/page.tsx ---\n```typescript\nimport { WorkTypeService } from \"@/services/WorkTypeService\";\nimport { WorkTypesClient } from \"./work-types-client\";\n\nexport default async function WorkTypesPage() {\n  const workTypes = await WorkTypeService.list();\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex justify-between items-center\">\n        <div>\n          <h3 className=\"text-lg font-medium text-gray-900\">Work Types</h3>\n          <p className=\"text-sm text-gray-500\">Manage definitions of work and deliverables.</p>\n        </div>\n      </div>\n\n      <WorkTypesClient workTypes={workTypes} />\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/work/[id]/page.tsx ---\n```typescript\nimport { notFound } from \"next/navigation\";\nimport Link from \"next/link\";\nimport { WorkItemService } from \"@/services/WorkItemService\";\nimport { TagService } from \"@/services/TagService\";\nimport { ClientService } from \"@/services/ClientService\";\nimport { WorkTypeService } from \"@/services/WorkTypeService\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { WorkHeader } from \"./work-header\";\nimport { StageActionButtons } from \"./stage-action-buttons\";\nimport { StageProgress } from \"./stage-progress\";\nimport { getSessionUser } from \"@/lib/auth/utils\";\n\nexport default async function WorkItemDetailPage({ params }: { params: Promise<{ id: string }> }) {\n  const { id } = await params;\n  const workItem = await WorkItemService.getById(id);\n  const user = await getSessionUser();\n\n  if (!workItem || !user) {\n    notFound();\n  }\n\n  const [tags, clients, workTypes] = await Promise.all([\n    TagService.list(),\n    ClientService.list(),\n    WorkTypeService.list()\n  ]);\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n        <Link href=\"/tl/work\" className=\"hover:text-indigo-600 hover:underline\">Work Items</Link>\n        <span>/</span>\n        <span className=\"text-gray-900\">{workItem.workNumber}</span>\n      </div>\n\n      <WorkHeader \n        workItem={workItem} \n        tags={tags} \n        clients={clients} \n        workTypes={workTypes} \n      />\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 space-y-6\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Stages</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {workItem.stages.map((stage: any, index: number) => {\n                  const isActive = stage.id === workItem.currentStageId;\n                  return (\n                    <div key={stage.id} className={`flex gap-4 p-4 border rounded-lg ${isActive ? \'bg-indigo-50 border-indigo-200\' : \'bg-white\'}`}>\n                      <div className=\"flex flex-col items-center justify-center border-r pr-4 min-w-[3rem]\">\n                        <div className={`text-sm font-medium ${isActive ? \'text-indigo-600\' : \'text-gray-400\'}`}>\n                          #{index + 1}\n                        </div>\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex justify-between items-start\">\n                          <div>\n                            <h4 className={`font-semibold ${isActive ? \'text-indigo-900\' : \'text-gray-900\'}`}>\n                              {stage.stageTemplate.name}\n                            </h4>\n                            <div className=\"text-sm text-gray-500 mt-1 flex gap-2\">\n                              <span>{stage.stageTemplate.estimatedDurationMins} mins</span>\n                              {stage.capability && (\n                                <>\n                                  <span>\342\200\242</span>\n                                  <span>{stage.capability.name}</span>\n                                </>\n                              )}\n                            </div>\n                          </div>\n                          <Badge variant={isActive ? \"default\" : (stage.status === \'COMPLETED\' ? \"secondary\" : \"outline\")}>\n                            {stage.status}\n                          </Badge>\n                        </div>\n                        {isActive && (\n                          <StageActionButtons stage={stage} workItemId={workItem.id} userRole={user.role} />\n                        )}\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n\n        <div className=\"space-y-6\">\n          <StageProgress workItem={workItem} />\n          \n          <Card>\n            <CardHeader>\n              <CardTitle>Details</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Description</h4>\n                <p className=\"mt-1 text-sm text-gray-900 whitespace-pre-wrap\">{workItem.description || \'No description provided.\'}</p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Client</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{workItem.client?.name || \'None\'}</p>\n              </div>\n\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Work Type</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">{workItem.workType?.name || \'None\'}</p>\n              </div>\n\n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Process</h4>\n                <p className=\"mt-1 text-sm text-gray-900\">\n                  {workItem.processVersion.template.name} (v{workItem.processVersion.version})\n                </p>\n              </div>\n              \n              <div>\n                <h4 className=\"text-sm font-medium text-gray-500\">Tags</h4>\n                <div className=\"flex flex-wrap gap-2 mt-1\">\n                  {workItem.tags.map((t: any) => (\n                    <Badge key={t.tagId} variant=\"outline\" style={{ borderColor: t.tag.color || undefined }}>\n                      {t.tag.name}\n                    </Badge>\n                  ))}\n                  {workItem.tags.length === 0 && <span className=\"text-sm text-gray-500\">None</span>}\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n```\n\n--- /app/(dashboard)/tl/work/page.tsx ---\n```typescript\nimport { WorkItemService } from \"@/services/WorkItemService\";\nimport { TagService } from \"@/services/TagService\";\nimport { ClientService } from \"@/services/ClientService\";\nimport { WorkTypeService } from \"@/services/WorkTypeService\";\nimport { ProcessTemplateService } from \"@/services/ProcessTemplateService\";\nimport { WorkClient } from \"./work-client\";\n\nexport default async function WorkItemsPage() {\n  const [workItems, tags, clients, workTypes, processes] = await Promise.all([\n    WorkItemService.list(),\n    TagService.list(),\n    ClientService.list(),\n    WorkTypeService.list(),\n    ProcessTemplateService.list()\n  ]);\n\n  const publishedProcesses = processes.filter(p => p.versions.some(v => v.isPublished));\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col gap-1\">\n        <h2 className=\"text-2xl font-bold tracking-tight text-gray-900\">Work Items</h2>\n        <p className=\"text-sm text-gray-500\">\n          Manage all active work across the studio.\n        </p>\n      </div>\n\n      <WorkClient \n        initialWorkItems={workItems} \n        tags={tags}\n        clients={clients}\n        workTypes={workTypes}\n        processes={publishedProcesses}\n      />\n    </div>\n  );\n}\n\n```\n\n--- /app/globals.css ---\n```css\n@import \"tailwindcss\";\n@import \"tw-animate-css\";\n@import \"shadcn/tailwind.css\";\n\n@custom-variant dark (&:is(.dark *));\n\n@theme inline {\n    --font-heading: var(--font-sans);\n    --font-sans: var(--font-sans);\n    --color-sidebar-ring: var(--sidebar-ring);\n    --color-sidebar-border: var(--sidebar-border);\n    --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);\n    --color-sidebar-accent: var(--sidebar-accent);\n    --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);\n    --color-sidebar-primary: var(--sidebar-primary);\n    --color-sidebar-foreground: var(--sidebar-foreground);\n    --color-sidebar: var(--sidebar);\n    --color-chart-5: var(--chart-5);\n    --color-chart-4: var(--chart-4);\n    --color-chart-3: var(--chart-3);\n    --color-chart-2: var(--chart-2);\n    --color-chart-1: var(--chart-1);\n    --color-ring: var(--ring);\n    --color-input: var(--input);\n    --color-border: var(--border);\n    --color-destructive: var(--destructive);\n    --color-accent-foreground: var(--accent-foreground);\n    --color-accent: var(--accent);\n    --color-muted-foreground: var(--muted-foreground);\n    --color-muted: var(--muted);\n    --color-secondary-foreground: var(--secondary-foreground);\n    --color-secondary: var(--secondary);\n    --color-primary-foreground: var(--primary-foreground);\n    --color-primary: var(--primary);\n    --color-popover-foreground: var(--popover-foreground);\n    --color-popover: var(--popover);\n    --color-card-foreground: var(--card-foreground);\n    --color-card: var(--card);\n    --color-foreground: var(--foreground);\n    --color-background: var(--background);\n    --radius-sm: calc(var(--radius) * 0.6);\n    --radius-md: calc(var(--radius) * 0.8);\n    --radius-lg: var(--radius);\n    --radius-xl: calc(var(--radius) * 1.4);\n    --radius-2xl: calc(var(--radius) * 1.8);\n    --radius-3xl: calc(var(--radius) * 2.2);\n    --radius-4xl: calc(var(--radius) * 2.6);\n}\n\n:root {\n    --background: oklch(1 0 0);\n    --foreground: oklch(0.145 0 0);\n    --card: oklch(1 0 0);\n    --card-foreground: oklch(0.145 0 0);\n    --popover: oklch(1 0 0);\n    --popover-foreground: oklch(0.145 0 0);\n    --primary: oklch(0.205 0 0);\n    --primary-foreground: oklch(0.985 0 0);\n    --secondary: oklch(0.97 0 0);\n    --secondary-foreground: oklch(0.205 0 0);\n    --muted: oklch(0.97 0 0);\n    --muted-foreground: oklch(0.556 0 0);\n    --accent: oklch(0.97 0 0);\n    --accent-foreground: oklch(0.205 0 0);\n    --destructive: oklch(0.577 0.245 27.325);\n    --border: oklch(0.922 0 0);\n    --input: oklch(0.922 0 0);\n    --ring: oklch(0.708 0 0);\n    --chart-1: oklch(0.87 0 0);\n    --chart-2: oklch(0.556 0 0);\n    --chart-3: oklch(0.439 0 0);\n    --chart-4: oklch(0.371 0 0);\n    --chart-5: oklch(0.269 0 0);\n    --radius: 0.625rem;\n    --sidebar: oklch(0.985 0 0);\n    --sidebar-foreground: oklch(0.145 0 0);\n    --sidebar-primary: oklch(0.205 0 0);\n    --sidebar-primary-foreground: oklch(0.985 0 0);\n    --sidebar-accent: oklch(0.97 0 0);\n    --sidebar-accent-foreground: oklch(0.205 0 0);\n    --sidebar-border: oklch(0.922 0 0);\n    --sidebar-ring: oklch(0.708 0 0);\n}\n\n.dark {\n    --background: oklch(0.145 0 0);\n    --foreground: oklch(0.985 0 0);\n    --card: oklch(0.205 0 0);\n    --card-foreground: oklch(0.985 0 0);\n    --popover: oklch(0.205 0 0);\n    --popover-foreground: oklch(0.985 0 0);\n    --primary: oklch(0.922 0 0);\n    --primary-foreground: oklch(0.205 0 0);\n    --secondary: oklch(0.269 0 0);\n    --secondary-foreground: oklch(0.985 0 0);\n    --muted: oklch(0.269 0 0);\n    --muted-foreground: oklch(0.708 0 0);\n    --accent: oklch(0.269 0 0);\n    --accent-foreground: oklch(0.985 0 0);\n    --destructive: oklch(0.704 0.191 22.216);\n    --border: oklch(1 0 0 / 10%);\n    --input: oklch(1 0 0 / 15%);\n    --ring: oklch(0.556 0 0);\n    --chart-1: oklch(0.87 0 0);\n    --chart-2: oklch(0.556 0 0);\n    --chart-3: oklch(0.439 0 0);\n    --chart-4: oklch(0.371 0 0);\n    --chart-5: oklch(0.269 0 0);\n    --sidebar: oklch(0.205 0 0);\n    --sidebar-foreground: oklch(0.985 0 0);\n    --sidebar-primary: oklch(0.488 0.243 264.376);\n    --sidebar-primary-foreground: oklch(0.985 0 0);\n    --sidebar-accent: oklch(0.269 0 0);\n    --sidebar-accent-foreground: oklch(0.985 0 0);\n    --sidebar-border: oklch(1 0 0 / 10%);\n    --sidebar-ring: oklch(0.556 0 0);\n}\n\n@layer base {\n  * {\n    @apply border-border outline-ring/50;\n    }\n  body {\n    @apply bg-background text-foreground;\n    }\n  html {\n    @apply font-sans;\n    }\n}\n```\n\n--- /app/layout.tsx ---\n```typescript\nimport type {Metadata} from \'next\';\nimport \'./globals.css\';\nimport { Geist } from \"next/font/google\";\nimport { cn } from \"@/lib/utils\";\n\nconst geist = Geist({subsets:[\'latin\'],variable:\'--font-sans\'});\n\nexport const metadata: Metadata = {\n  title: \'My Google AI Studio App\',\n  description: \'My Google AI Studio App\',\n};\n\nexport default function RootLayout({children}: {children: React.ReactNode}) {\n  return (\n    <html lang=\"en\" className={cn(\"font-sans\", geist.variable)}>\n      <body suppressHydrationWarning>{children}</body>\n    </html>\n  );\n}\n\n```\n\n--- /app/page.tsx ---\n```typescript\nimport { getSessionUser } from \"@/lib/auth/utils\";\nimport { redirect } from \"next/navigation\";\n\nexport default async function HomePage() {\n  const user = await getSessionUser();\n\n  if (!user) {\n    redirect(\"/login\");\n  }\n\n  if (user.role === \"TEAM_LEADER\") {\n    redirect(\"/tl\");\n  } else {\n    redirect(\"/employee\");\n  }\n}\n\n```\n\n--- /components.json ---\n```json\n{\n  \"$schema\": \"https://ui.shadcn.com/schema.json\",\n  \"style\": \"base-nova\",\n  \"rsc\": true,\n  \"tsx\": true,\n  \"tailwind\": {\n    \"config\": \"\",\n    \"css\": \"app/globals.css\",\n    \"baseColor\": \"neutral\",\n    \"cssVariables\": true,\n    \"prefix\": \"\"\n  },\n  \"iconLibrary\": \"lucide\",\n  \"rtl\": false,\n  \"aliases\": {\n    \"components\": \"@/components\",\n    \"utils\": \"@/lib/utils\",\n    \"ui\": \"@/components/ui\",\n    \"lib\": \"@/lib\",\n    \"hooks\": \"@/hooks\"\n  },\n  \"menuColor\": \"default\",\n  \"menuAccent\": \"subtle\",\n  \"registries\": {}\n}\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix: Studio.Track\",\n  \"description\": \"Creative Operations Platform for content production agencies.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /next.config.ts ---\n```typescript\nimport type {NextConfig} from \'next\';\n\nconst nextConfig: NextConfig = {\n  reactStrictMode: true,\n  eslint: {\n    ignoreDuringBuilds: true,\n  },\n  typescript: {\n    ignoreBuildErrors: false,\n  },\n  // Allow access to remote image placeholder.\n  images: {\n    remotePatterns: [\n      {\n        protocol: \'https\',\n        hostname: \'picsum.photos\',\n        port: \'\',\n        pathname: \'/**\', // This allows any path under the hostname\n      },\n    ],\n  },\n  output: \'standalone\',\n  transpilePackages: [\'motion\'],\n  webpack: (config, {dev}) => {\n    // HMR is disabled in AI Studio via DISABLE_HMR env var.\n    // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n    if (dev && process.env.DISABLE_HMR === \'true\') {\n      config.watchOptions = {\n        ignored: /.*/,\n      };\n    }\n    return config;\n  },\n};\n\nexport default nextConfig;\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2017\",\n    \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n    \"allowJs\": true,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"esModuleInterop\": true,\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"jsx\": \"preserve\",\n    \"incremental\": true,\n    \"plugins\": [\n      {\n        \"name\": \"next\"\n      }\n    ],\n    \"baseUrl\": \".\",\n    \"paths\": {\n      \"@/*\": [\"./*\"]\n    }\n  },\n  \"include\": [\"next-env.d.ts\", \"**/*.ts\", \"**/*.tsx\", \".next/types/**/*.ts\"],\n  \"exclude\": [\"node_modules\"]\n}\n\n```"
