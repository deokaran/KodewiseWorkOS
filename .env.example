# -----------------------------------------------------------------------------
# Studio.Track - Environment Variables
# -----------------------------------------------------------------------------

# APP_URL: The canonical URL where this application is hosted.
# Used for authentication callbacks and absolute links in emails.
APP_URL="http://localhost:3000"

# PRISMA / NEON POSTGRESQL
# DATABASE_URL is used by the application for standard querying.
# DIRECT_URL is required by Prisma for executing schema migrations on Neon.
DATABASE_URL="postgres://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/studiotrack?sslmode=require"
DIRECT_URL="postgres://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/studiotrack?sslmode=require"

# AUTH.JS (NextAuth)
# Generate a secret using: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your_generated_auth_secret_here"
